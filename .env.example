# Copie ce fichier vers .env.local, puis remplis les deux variables.
# Ces valeurs se trouvent dans Supabase : Project Settings > API.
# VITE_SUPABASE_ANON_KEY accepte la clé « publishable » (ou « anon public »).
# N'utilise jamais la clé secrète / service_role dans ce projet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mets "true" uniquement si le fournisseur Google est activé dans Supabase.
VITE_ENABLE_GOOGLE=false
